# ITMS environment — copy to .env (gitignored) and fill in real values.
# Covers EVERY backend + compose variable. Placeholders below are SHAPE-ONLY
# examples, never real secrets.
#
# Generate secrets with:
#   openssl rand -hex 24   # POSTGRES_PASSWORD (48 hex chars)
#   openssl rand -hex 32   # INTAKE_TOKEN (64 hex chars)

# ── Database (REQUIRED) ──────────────────────────────────────────────
# Compose builds the backend's DATABASE_URL from this; the db service also
# uses it for POSTGRES_PASSWORD. Example shape: 48 hex chars.
POSTGRES_PASSWORD=aa00bb11cc22dd33ee44ff5566778899001122334455667788

# Local-dev only (cargo run): compose constructs DATABASE_URL itself, but the
# server/seed binaries read DATABASE_URL directly, so local runs need it.
# Shape: postgres://itms:<POSTGRES_PASSWORD>@localhost:5432/itms
#DATABASE_URL=postgres://itms:aa00bb11cc22dd33ee44ff5566778899001122334455667788@localhost:5432/itms

# ── Backend server ───────────────────────────────────────────────────
# Port the server listens on inside the container (default 8080).
PORT=8080
# Upload storage dir inside the container (default /app/uploads — matches the
# compose volume mount; only override for local dev).
UPLOAD_DIR=/app/uploads
# Log filter (default: info,tower_http=debug,axum::rejection=trace).
RUST_LOG=info

# ── Email intake (optional; empty = intake endpoints reject) ──────────
# Shared secret the ticketing cron sends as X-Intake-Token. Shape: 64 hex.
INTAKE_TOKEN=

# ── Invoice OCR/parsing (optional; empty = parse returns "not configured") ──
# Bearer key for the mimo-v2.5 parse backend (OpenCode Go). Shape: sk-...
OPENCODE_GO_API_KEY=

# ── Demo login (default-DENY — keep false in prod) ───────────────────
# The /auth/demo endpoint answers ONLY when this is exactly "true".
DEMO_LOGIN_ENABLED=false
# Which seeded user the demo button logs in as (must exist in users table).
DEMO_LOGIN_EMAIL=demo@itms.local

# ── Rate-limit proxy trust (optional; empty = trust none, key on peer IP) ──
# Comma-separated IPv4 addresses and/or CIDRs allowed to vouch
# X-Forwarded-For (e.g. the nginx + traefik hops). Shape: 172.18.0.0/16,10.0.0.2
TRUSTED_PROXIES=

# ── Google SSO test overrides (TEST-ONLY — never set in prod) ────────
# Point the OAuth flow at a mock IdP for local verification. Unset = real
# Google endpoints (accounts.google.com / oauth2.googleapis.com).
#GOOGLE_OAUTH_AUTH_URL=http://localhost:8081/mock-auth
#GOOGLE_OAUTH_TOKEN_URL=http://localhost:8081/mock-token
#GOOGLE_OAUTH_USERINFO_URL=http://localhost:8081/mock-userinfo

# ── Deploy image pins (compose; set by build-deploy.sh, not .env normally) ──
# Immutable per-commit tags (itms-<sha8>); rollback = re-point these at the
# previous good SHA — see docs/ROLLBACK.md. Default when unset: itms-latest.
#BACKEND_TAG=itms-1a2b3c4d
#FRONTEND_TAG=itms-1a2b3c4d

# ── Timezone (compose default; rarely needs changing) ────────────────
TZ=Asia/Kolkata
